FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pytest rsync acl && rm -r /var/lib/apt/lists/*
RUN useradd --create-home tester
USER tester
ENV PYTHONPATH=/source PYTHONDONTWRITEBYTECODE=1
WORKDIR /tmp
CMD ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "/source/tests"]
